    "**/target/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    ".git/**",
    ".moon/cache/**",
    "**/*.node",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.log",
    "**/package-lock.json",
    "**/npm-shrinkwrap.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/Cargo.lock",
    "packages/eslint-formatter-crisp/.napi-generated.d.ts"
  ]
